// services/inventory-service/prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

// ─── Unit of Measure ──────────────────────────────────────────────────────────

model Unit {
  id           String   @id @default(uuid())
  restaurantId String
  name         String   // e.g. "Kilogram"
  abbreviation String   // e.g. "kg"
  isBase       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ingredients  Ingredient[]
  fromConversions UnitConversion[] @relation("FromUnit")
  toConversions   UnitConversion[] @relation("ToUnit")

  @@unique([restaurantId, abbreviation])
  @@index([restaurantId])
}

model UnitConversion {
  id         String  @id @default(uuid())
  fromUnitId String
  toUnitId   String
  factor     Decimal @db.Decimal(18, 8) // multiply fromUnit qty by factor to get toUnit qty

  fromUnit   Unit @relation("FromUnit", fields: [fromUnitId], references: [id])
  toUnit     Unit @relation("ToUnit",   fields: [toUnitId],   references: [id])

  @@unique([fromUnitId, toUnitId])
}

// ─── Supplier ─────────────────────────────────────────────────────────────────

model Supplier {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  contactName  String?
  email        String?
  phone        String?
  address      String?
  taxId        String?
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchaseReceipts PurchaseReceipt[]

  @@index([restaurantId])
}

// ─── Ingredient ───────────────────────────────────────────────────────────────

model Ingredient {
  id                String   @id @default(uuid())
  restaurantId      String
  name              String
  description       String?
  unitId            String
  sku               String?
  barcode           String?
  reorderPoint      Decimal  @db.Decimal(12, 4) @default(0)
  reorderQuantity   Decimal  @db.Decimal(12, 4) @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  unit              Unit     @relation(fields: [unitId], references: [id])
  stockLevels       StockLevel[]
  lots              Lot[]
  movementLines     StockMovementLine[]

  @@unique([restaurantId, sku])
  @@index([restaurantId])
}

// ─── Warehouse ────────────────────────────────────────────────────────────────

model Warehouse {
  id           String   @id @default(uuid())
  restaurantId String
  branchId     String?
  name         String
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stockLevels  StockLevel[]
  lots         Lot[]
  fromTransfers StockMovement[] @relation("FromWarehouse")
  toTransfers   StockMovement[] @relation("ToWarehouse")

  @@index([restaurantId])
  @@index([restaurantId, branchId])
}

// ─── Stock Level (current snapshot per ingredient per warehouse) ───────────────

model StockLevel {
  id           String   @id @default(uuid())
  ingredientId String
  warehouseId  String
  quantity     Decimal  @db.Decimal(12, 4) @default(0)
  reservedQty  Decimal  @db.Decimal(12, 4) @default(0)
  updatedAt    DateTime @updatedAt

  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  warehouse    Warehouse  @relation(fields: [warehouseId], references: [id])

  @@unique([ingredientId, warehouseId])
  @@index([warehouseId])
}

// ─── Lot (batch tracking) ─────────────────────────────────────────────────────

model Lot {
  id             String    @id @default(uuid())
  ingredientId   String
  warehouseId    String
  lotNumber      String
  expiresAt      DateTime?
  manufacturedAt DateTime?
  quantity       Decimal   @db.Decimal(12, 4)
  remainingQty   Decimal   @db.Decimal(12, 4)
  costPerUnit    Decimal   @db.Decimal(12, 4)
  createdAt      DateTime  @default(now())

  ingredient     Ingredient @relation(fields: [ingredientId], references: [id])
  warehouse      Warehouse  @relation(fields: [warehouseId], references: [id])

  @@index([ingredientId, warehouseId])
  @@index([expiresAt])
}

// ─── Stock Movement (immutable ledger) ────────────────────────────────────────

enum MovementType {
  RECEIPT       // purchase received
  ADJUSTMENT    // manual correction
  TRANSFER_OUT  // leaving a warehouse
  TRANSFER_IN   // arriving at a warehouse
  WASTE         // spoilage / disposal
  CONSUMPTION   // used in production / order
  RETURN        // returned to supplier
}

enum MovementStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model StockMovement {
  id              String         @id @default(uuid())
  restaurantId    String
  type            MovementType
  status          MovementStatus @default(PENDING)
  referenceId     String?        // orderId, receiptId, etc.
  referenceType   String?        // "order", "purchase_receipt", etc.
  fromWarehouseId String?
  toWarehouseId   String?
  notes           String?
  performedById   String?        // userId
  confirmedById   String?
  confirmedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  fromWarehouse   Warehouse?     @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse?     @relation("ToWarehouse",   fields: [toWarehouseId],   references: [id])
  lines           StockMovementLine[]
  purchaseReceipt PurchaseReceipt?

  @@index([restaurantId])
  @@index([restaurantId, type])
  @@index([referenceId, referenceType])
}

model StockMovementLine {
  id           String    @id @default(uuid())
  movementId   String
  ingredientId String
  quantity     Decimal   @db.Decimal(12, 4)  // positive = in, negative = out
  unitCost     Decimal?  @db.Decimal(12, 4)
  lotId        String?
  notes        String?

  movement     StockMovement @relation(fields: [movementId], references: [id])
  ingredient   Ingredient    @relation(fields: [ingredientId], references: [id])

  @@index([movementId])
  @@index([ingredientId])
}

// ─── Purchase Receipt ─────────────────────────────────────────────────────────

model PurchaseReceipt {
  id           String    @id @default(uuid())
  restaurantId String
  movementId   String    @unique
  supplierId   String
  invoiceNo    String?
  invoiceDate  DateTime?
  totalAmount  Decimal   @db.Decimal(12, 4)
  currency     String    @default("USD")
  receivedAt   DateTime  @default(now())
  notes        String?
  createdAt    DateTime  @default(now())

  movement     StockMovement @relation(fields: [movementId], references: [id])
  supplier     Supplier      @relation(fields: [supplierId], references: [id])

  @@index([restaurantId])
  @@index([supplierId])
}